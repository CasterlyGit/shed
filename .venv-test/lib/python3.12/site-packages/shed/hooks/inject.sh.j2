#!/usr/bin/env bash
# shed inject hook — UserPromptSubmit
# Reads JSON event on stdin, extracts the prompt, asks shed for context,
# echoes the <shed-context> block on stdout (which Claude Code prepends
# to the user's prompt).
#
# Hard rules: 2s timeout, fail open (no output) on any failure.

set -u
exec 2>>"{{ log_file }}"

input="$(cat)"

prompt="$(printf '%s' "$input" | "{{ python }}" -c '
import json, sys
try:
    d = json.loads(sys.stdin.read() or "{}")
    print(d.get("prompt") or d.get("user_prompt") or "")
except Exception:
    print("")
')"

if [ -z "$prompt" ]; then
  exit 0
fi

# 2s hard timeout. macOS lacks `timeout`; use Python.
"{{ python }}" - <<'PY' "$prompt" || true
import sys, signal
prompt = sys.argv[1]
def _timeout(sig, frame):
    sys.exit(0)
signal.signal(signal.SIGALRM, _timeout)
signal.setitimer(signal.ITIMER_REAL, 2.0)
try:
    from shed.inject import inject_for_prompt
    res = inject_for_prompt(prompt)
    if res.block:
        sys.stdout.write(res.block)
except SystemExit:
    pass
except Exception as e:
    sys.stderr.write(f"shed inject failed: {e}\n")
PY

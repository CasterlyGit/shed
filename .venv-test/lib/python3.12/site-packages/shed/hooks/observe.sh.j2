#!/usr/bin/env bash
# shed observe hook — PostToolUse
set -u
exec 2>>"{{ log_file }}"

input="$(cat)"

text="$(printf '%s' "$input" | "{{ python }}" -c '
import json, sys
try:
    d = json.loads(sys.stdin.read() or "{}")
    # Try a few likely keys; we want any user-visible text.
    for k in ("user_message", "prompt", "transcript", "input", "content"):
        v = d.get(k)
        if isinstance(v, str) and v.strip():
            print(v)
            break
except Exception:
    print("")
')"

if [ -z "$text" ]; then
  exit 0
fi

"{{ python }}" - <<'PY' "$text" || true
import sys, signal
text = sys.argv[1]
def _to(sig, frame):
    sys.exit(0)
signal.signal(signal.SIGALRM, _to)
signal.setitimer(signal.ITIMER_REAL, 2.0)
try:
    from shed.observe import observe_text
    observe_text(text)
except SystemExit:
    pass
except Exception as e:
    sys.stderr.write(f"shed observe failed: {e}\n")
PY

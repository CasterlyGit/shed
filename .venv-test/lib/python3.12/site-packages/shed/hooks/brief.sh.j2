#!/usr/bin/env bash
# shed brief hook — SessionStart
# Emits a short summary of pending proposals so Claude opens with awareness.
set -u
exec 2>>"{{ log_file }}"

"{{ python }}" - <<'PY' || true
import sys, signal
def _to(sig, frame):
    sys.exit(0)
signal.signal(signal.SIGALRM, _to)
signal.setitimer(signal.ITIMER_REAL, 2.0)
try:
    from shed.brief import render_brief
    sys.stdout.write(render_brief() or "")
except SystemExit:
    pass
except Exception as e:
    sys.stderr.write(f"shed brief failed: {e}\n")
PY
